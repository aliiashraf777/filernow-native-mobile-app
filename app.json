{
  "expo": {
    "name": "KhataPilot",
    "slug": "KhataPilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/khataPilotUp.png",
    "scheme": "filernowmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/khataPilotUp.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.anonymous.KhataPilot"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/khataPilotUp.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/khataPilotUp.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID to log you in."
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}